// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 0: HEADER
// ═══════════════════════════════════════════════════════════════════════════════

//@version=5
indicator("BTC Cycle Master - @killaxbt Analysis", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 1: INPUT PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Display Settings ---
i_showHalvings      = input.bool(true, "Show Halving Lines",          group="📊 Display Settings")
i_showElections     = input.bool(true, "Show Election Day Lines",     group="📊 Display Settings")
i_showATH           = input.bool(true, "Show ATH Markers",           group="📊 Display Settings")
i_showATHBreakDays  = input.bool(true, "Show ATH Break Days Labels", group="📊 Display Settings")
i_showBottomMarkers = input.bool(true, "Show Cycle Bottom Markers",  group="📊 Display Settings")
i_showPeakAnalysis  = input.bool(true, "Show Peak-to-Peak Analysis", group="📊 Display Settings")
i_showPhases        = input.bool(true, "Show Cycle Phases",          group="📊 Display Settings")
i_showLogCurves     = input.bool(true, "Show Log Growth Curves",     group="📊 Display Settings")
i_showDashboard     = input.bool(true, "Show Info Dashboard",        group="📊 Display Settings")
i_showProjections   = input.bool(true, "Show Projected Zones",       group="📊 Display Settings")

// --- Colors ---
i_halvingColor    = input.color(color.yellow, "Halving Color",           group="🎨 Colors")
i_electionColor   = input.color(color.red,    "Election Color",          group="🎨 Colors")
i_athColor        = input.color(color.lime,   "ATH Color",              group="🎨 Colors")
i_bottomColor     = input.color(color.aqua,   "Bottom Color",           group="🎨 Colors")
i_bullColor       = input.color(color.green,  "Bull Color",             group="🎨 Colors")
i_bearColor       = input.color(color.red,    "Bear Color",             group="🎨 Colors")
i_projTopColor    = input.color(color.orange, "Projection Top Color",   group="🎨 Colors")
i_projBottomColor = input.color(color.teal,   "Projection Bottom Color", group="🎨 Colors")

// --- Analysis Settings ---
i_phaseStyle    = input.string("Background", "Phase Display Style", options=["Background", "Bars", "None"], group="🔧 Analysis Settings", tooltip="How to visualize the current cycle phase")
i_dashPosition  = input.string("Top Right",  "Dashboard Position",  options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="🔧 Analysis Settings")
i_logGrowthRate = input.float(0.003, "Log Growth Rate (daily)", minval=0.0001, maxval=0.01, step=0.0001, group="🔧 Analysis Settings", tooltip="Daily log growth rate for fair value curve. Default 0.003 ≈ 0.3%/day. Lower = more conservative curve.")

// --- Label Size Settings ---
i_labelSizeMajor  = input.string("small", "Major Labels (Halving/Election)", options=["tiny", "small", "normal", "large", "huge"], group="🔤 Label Sizes")
i_labelSizeMedium = input.string("small", "Medium Labels (Bottom/Peak/ATH Break)", options=["tiny", "small", "normal", "large", "huge"], group="🔤 Label Sizes")
i_labelSizeMinor  = input.string("tiny", "Minor Labels (Bottom-to-Top / P2P)", options=["tiny", "small", "normal", "large", "huge"], group="🔤 Label Sizes")
i_labelSizeZone   = input.string("small", "Projection Zone Labels", options=["tiny", "small", "normal", "large", "huge"], group="🔤 Label Sizes")

// Convert string to size constant
sizeFromString(string s) =>
    switch s
        "tiny"   => size.tiny
        "small"  => size.small
        "normal" => size.normal
        "large"  => size.large
        "huge"   => size.huge
        =>          size.small

lblSizeMajor  = sizeFromString(i_labelSizeMajor)
lblSizeMedium = sizeFromString(i_labelSizeMedium)
lblSizeMinor  = sizeFromString(i_labelSizeMinor)
lblSizeZone   = sizeFromString(i_labelSizeZone)

// --- Help & Usage ---
i_showHelp = input.bool(false, "Show Help Panel (How to Use)", group="❓ Help")

// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 2: CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Halving Dates (UTC) ---
HALVING_1 = timestamp("UTC", 2012, 11, 28, 0, 0)
HALVING_2 = timestamp("UTC", 2016,  7,  9, 0, 0)
HALVING_3 = timestamp("UTC", 2020,  5, 11, 0, 0)
HALVING_4 = timestamp("UTC", 2024,  4, 20, 0, 0)
HALVING_5 = timestamp("UTC", 2028,  3, 15, 0, 0)  // Estimated

// --- Election Dates (UTC) ---
ELECTION_2012 = timestamp("UTC", 2012, 11,  6, 0, 0)
ELECTION_2016 = timestamp("UTC", 2016, 11,  8, 0, 0)
ELECTION_2020 = timestamp("UTC", 2020, 11,  3, 0, 0)
ELECTION_2024 = timestamp("UTC", 2024, 11,  5, 0, 0)
ELECTION_2028 = timestamp("UTC", 2028, 11,  7, 0, 0)

// --- Cycle Bottom Dates (User Override) ---
BOTTOM_1 = input.time(timestamp("UTC", 2011, 11, 18, 0, 0), "Bottom 1 (2011)", group="Cycle Dates (Manual Override)", confirm=false, tooltip="First Bitcoin cycle bottom")
BOTTOM_2 = input.time(timestamp("UTC", 2015,  1, 14, 0, 0), "Bottom 2 (2015)", group="Cycle Dates (Manual Override)", confirm=false)
BOTTOM_3 = input.time(timestamp("UTC", 2018, 12, 15, 0, 0), "Bottom 3 (2018)", group="Cycle Dates (Manual Override)", confirm=false)
BOTTOM_4 = input.time(timestamp("UTC", 2022, 11, 21, 0, 0), "Bottom 4 (2022)", group="Cycle Dates (Manual Override)", confirm=false)

// --- Cycle Peak Dates (User Override) ---
PEAK_1 = input.time(timestamp("UTC", 2011,  6,  8, 0, 0), "Peak 1 (2011)", group="Cycle Dates (Manual Override)", confirm=false)
PEAK_2 = input.time(timestamp("UTC", 2013, 11, 30, 0, 0), "Peak 2 (2013)", group="Cycle Dates (Manual Override)", confirm=false)
PEAK_3 = input.time(timestamp("UTC", 2017, 12, 17, 0, 0), "Peak 3 (2017)", group="Cycle Dates (Manual Override)", confirm=false)
PEAK_4 = input.time(timestamp("UTC", 2021, 11, 10, 0, 0), "Peak 4 (2021)", group="Cycle Dates (Manual Override)", confirm=false)

// --- 2025 Cycle (5th Peak) - Set to actual top when confirmed ---
i_usePeak5 = input.bool(false, "Use Peak 5 (2025 Top)", group="Cycle Dates (Manual Override)", tooltip="Enable once the 2025 cycle top is confirmed. When enabled, projections use PEAK_5 as the latest top instead of PEAK_4.")
PEAK_5 = input.time(timestamp("UTC", 2025,  1, 20, 0, 0), "Peak 5 (2025) - default: 2025-01-20", group="Cycle Dates (Manual Override)", confirm=false, tooltip="Date of the 5th BTC cycle top (2025). Adjust to the actual peak date.")

// --- Helper Constant ---
MS_PER_DAY = 86400000

// --- Halving Arrays ---
var array<int>    halvingDates = array.from(HALVING_1, HALVING_2, HALVING_3, HALVING_4, HALVING_5)
var array<string> halvingNames = array.from("Halving #1", "Halving #2", "Halving #3", "Halving #4", "Halving #5")

// --- Election Arrays ---
var array<int>    electionDates = array.from(ELECTION_2012, ELECTION_2016, ELECTION_2020, ELECTION_2024, ELECTION_2028)
var array<string> electionNames = array.from("Election 2012", "Election 2016", "Election 2020", "Election 2024", "Election 2028")

// NOTE: bottomDates and peakDates arrays are defined dynamically in section_2.pine
//       based on manual overrides and/or auto-detection results.


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Convert timestamp difference to days
daysFromMs(int ms) =>
    int(math.floor(ms / float(MS_PER_DAY)))

// Check if current bar crosses a timestamp
crossesDate(int targetTime) =>
    not na(time[1]) and time[1] < targetTime and time >= targetTime

// Format days as string with "d" suffix
formatDays(int d) =>
    str.tostring(d) + "d"

// Zero-pad integer to two digits
padZero(int n) => n < 10 ? "0" + str.tostring(n) : str.tostring(n)

// Format a timestamp as YYYY-MM-DD
formatDate(int t) => str.tostring(year(t)) + "-" + padZero(month(t)) + "-" + padZero(dayofmonth(t))


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: FEATURE 1 - HALVING MARKERS
// ═══════════════════════════════════════════════════════════════════════════════

var int lastHalvingTime = na

if i_showHalvings
    for i = 0 to array.size(halvingDates) - 1
        int hDate = array.get(halvingDates, i)
        if crossesDate(hDate) and barstate.isconfirmed
            // Draw vertical dashed line at halving date
            line.new(x1=hDate, y1=low, x2=hDate, y2=high, xloc=xloc.bar_time, extend=extend.both, color=i_halvingColor, style=line.style_dashed, width=1)
            // Format the date string for label
            string dateStr = formatDate(hDate)
            string lblText = array.get(halvingNames, i) + "\n" + dateStr
            label.new(x=hDate, y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=lblText, style=label.style_label_down, color=i_halvingColor, textcolor=color.black, size=lblSizeMajor)

// Track the most recent halving that has passed
if array.size(halvingDates) > 0
    for i = 0 to array.size(halvingDates) - 1
        int hDate = array.get(halvingDates, i)
        if time >= hDate
            lastHalvingTime := hDate

// Calculate days since last halving
int daysSinceHalving = not na(lastHalvingTime) ? daysFromMs(time - lastHalvingTime) : -1


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: FEATURE 2 - ELECTION DAY MARKERS
// ═══════════════════════════════════════════════════════════════════════════════

if i_showElections
    for i = 0 to array.size(electionDates) - 1
        int eDate = array.get(electionDates, i)
        if crossesDate(eDate) and barstate.isconfirmed
            // Draw vertical dashed line at election date
            line.new(x1=eDate, y1=low, x2=eDate, y2=high, xloc=xloc.bar_time, extend=extend.both, color=i_electionColor, style=line.style_dashed, width=1)
            // Format the date string for label
            string dateStr = formatDate(eDate)
            string lblText = "🗳 Election\n" + dateStr
            label.new(x=eDate, y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=lblText, style=label.style_label_down, color=i_electionColor, textcolor=color.white, size=lblSizeMajor)


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4c: DYNAMIC CYCLE BASE PRICE
// ═══════════════════════════════════════════════════════════════════════════════

// Dynamic cycle base price: price at the last bottom
var float cycleBasePrice = 15500.0  // fallback default

// Update cycleBasePrice when we cross the last bottom
if crossesDate(BOTTOM_4) and barstate.isconfirmed
    cycleBasePrice := close


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: FEATURE 3 - ATH DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

var float ath = na
var int   athBarTime = na
var int   prevAthBarTime = 0
var bool  isNewATH = false
var int   athCount = 0

// Reset flag each bar
isNewATH := false

if na(ath) or high > ath
    prevAthBarTime := na(athBarTime) ? 0 : athBarTime
    ath            := high
    athBarTime     := time
    isNewATH       := athCount > 0  // suppress first-bar false positive
    athCount       += 1

int daysSinceATH = not na(athBarTime) ? daysFromMs(time - athBarTime) : 0


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 6: FEATURE 3 - ATH BREAK DAYS & ATH VISUAL MARKERS
// ═══════════════════════════════════════════════════════════════════════════════

// --- ATH Break Days (days from halving to first new ATH after that halving) ---
var int   halvingForATHBreak = 0
var bool  athBrokenAfterHalving = false
var int[] athBreakDaysArray = array.new_int(0)

// Detect when we cross any halving date and reset ATH break tracking
for i = 0 to array.size(halvingDates) - 1
    int hDate = array.get(halvingDates, i)
    if crossesDate(hDate)
        halvingForATHBreak    := hDate
        athBrokenAfterHalving := false

// When a new ATH is detected and we haven't broken ATH yet after the current halving
if isNewATH and halvingForATHBreak > 0 and not athBrokenAfterHalving and barstate.isconfirmed
    int breakDays = daysFromMs(time - halvingForATHBreak)
    array.push(athBreakDaysArray, breakDays)
    if array.size(athBreakDaysArray) > 10
        array.shift(athBreakDaysArray)
    athBrokenAfterHalving := true
    if i_showATHBreakDays
        string breakText = "ATH Break\n" + str.tostring(breakDays) + "d"
        label.new(x=time, y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=breakText, style=label.style_label_down, color=i_athColor, textcolor=color.black, size=lblSizeMedium)

// --- ATH Visual Markers (only significant ones: 30+ day gap from previous ATH) ---
if isNewATH and i_showATH and athCount > 1 and barstate.isconfirmed
    int gapFromPrevATH = prevAthBarTime > 0 ? daysFromMs(time - prevAthBarTime) : 9999
    if gapFromPrevATH >= 60 and time > (timenow - 730 * 86400000)  // only last 2 years
        label.new(x=time, y=low, xloc=xloc.bar_time, yloc=yloc.belowbar, text="", style=label.style_triangleup, color=i_athColor, size=lblSizeMinor)


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 7: FEATURE 4 - CYCLE BOTTOM DETECTION
// ═══════════════════════════════════════════════════════════════════════════════

var int lastBottomTime = 0
var int currentBottomIdx = -1

// Detect when the bar crosses a bottom date (BOTTOM_1..4 user inputs)
for i = 0 to 3
    int bDate = i == 0 ? BOTTOM_1 : i == 1 ? BOTTOM_2 : i == 2 ? BOTTOM_3 : BOTTOM_4
    if crossesDate(bDate)
        lastBottomTime  := bDate
        currentBottomIdx := i
        if i_showBottomMarkers and barstate.isconfirmed
            string dateStr = formatDate(bDate)
            string lblText = "Cycle Bottom\n" + dateStr
            label.new(x=bDate, y=low, xloc=xloc.bar_time, yloc=yloc.belowbar, text=lblText, style=label.style_label_up, color=i_bottomColor, textcolor=color.black, size=lblSizeMedium)

int daysSinceBottom = lastBottomTime > 0 ? daysFromMs(time - lastBottomTime) : 0

// --- Bottom-to-Top Measurements ---
// Draw lines and labels connecting each bottom to the next cycle peak.
// BOTTOM_1 -> PEAK_2, BOTTOM_2 -> PEAK_3, BOTTOM_3 -> PEAK_4, BOTTOM_4 -> projected
// We draw these once, on the bar that crosses the peak date (or last bar for projection).

var bool drewB1toP2 = false
var bool drewB2toP3 = false
var bool drewB3toP4 = false
var bool drewB4toProj = false

// BOTTOM_1 to PEAK_2
if crossesDate(PEAK_2) and not drewB1toP2 and i_showBottomMarkers and barstate.isconfirmed
    int dur = daysFromMs(PEAK_2 - BOTTOM_1)
    string durText = "bottom to top\n" + str.tostring(dur) + "d"
    line.new(x1=BOTTOM_1, y1=close, x2=PEAK_2, y2=close, xloc=xloc.bar_time, color=i_bottomColor, style=line.style_arrow_right, width=1)
    label.new(x=math.round((BOTTOM_1 + PEAK_2) / 2), y=close, xloc=xloc.bar_time, text=durText, style=label.style_label_up, color=i_bottomColor, textcolor=color.black, size=lblSizeMinor)
    drewB1toP2 := true

// BOTTOM_2 to PEAK_3
if crossesDate(PEAK_3) and not drewB2toP3 and i_showBottomMarkers and barstate.isconfirmed
    int dur = daysFromMs(PEAK_3 - BOTTOM_2)
    string durText = "bottom to top\n" + str.tostring(dur) + "d"
    line.new(x1=BOTTOM_2, y1=close, x2=PEAK_3, y2=close, xloc=xloc.bar_time, color=i_bottomColor, style=line.style_arrow_right, width=1)
    label.new(x=math.round((BOTTOM_2 + PEAK_3) / 2), y=close, xloc=xloc.bar_time, text=durText, style=label.style_label_up, color=i_bottomColor, textcolor=color.black, size=lblSizeMinor)
    drewB2toP3 := true

// BOTTOM_3 to PEAK_4
if crossesDate(PEAK_4) and not drewB3toP4 and i_showBottomMarkers and barstate.isconfirmed
    int dur = daysFromMs(PEAK_4 - BOTTOM_3)
    string durText = "bottom to top\n" + str.tostring(dur) + "d"
    line.new(x1=BOTTOM_3, y1=close, x2=PEAK_4, y2=close, xloc=xloc.bar_time, color=i_bottomColor, style=line.style_arrow_right, width=1)
    label.new(x=math.round((BOTTOM_3 + PEAK_4) / 2), y=close, xloc=xloc.bar_time, text=durText, style=label.style_label_up, color=i_bottomColor, textcolor=color.black, size=lblSizeMinor)
    drewB3toP4 := true

// BOTTOM_4 to projected peak (drawn on last bar)
// projectedPeakTime is computed in section 8 below, so we draw this after that section.
// We use a forward reference placeholder; actual drawing is at the end of this file.


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 8: FEATURE 5 - PEAK-TO-PEAK ANALYSIS
// ═══════════════════════════════════════════════════════════════════════════════

var int lastPeakTime = 0

// Detect when the bar crosses a peak date (PEAK_1..4 user inputs + optional PEAK_5)
int peakCount = i_usePeak5 ? 4 : 3
for i = 0 to peakCount
    int pDate = i == 0 ? PEAK_1 : i == 1 ? PEAK_2 : i == 2 ? PEAK_3 : i == 3 ? PEAK_4 : PEAK_5
    if crossesDate(pDate)
        lastPeakTime := pDate
        if i_showPeakAnalysis and barstate.isconfirmed
            string dateStr = formatDate(pDate)
            string lblText = "Peak #" + str.tostring(i + 1) + "\n" + dateStr
            label.new(x=pDate, y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=lblText, style=label.style_square, color=color.orange, textcolor=color.white, size=lblSizeMedium)

// --- Peak-to-Peak Intervals ---
int p1_to_p2 = daysFromMs(PEAK_2 - PEAK_1)
int p2_to_p3 = daysFromMs(PEAK_3 - PEAK_2)
int p3_to_p4 = daysFromMs(PEAK_4 - PEAK_3)

// Draw peak-to-peak connecting lines and labels (once, when crossing PEAK_2, PEAK_3, PEAK_4)
var bool drewP1toP2 = false
var bool drewP2toP3 = false
var bool drewP3toP4 = false

if crossesDate(PEAK_2) and not drewP1toP2 and i_showPeakAnalysis and barstate.isconfirmed
    string pText = "peak to peak\n" + str.tostring(p1_to_p2) + "d"
    line.new(x1=PEAK_1, y1=high, x2=PEAK_2, y2=high, xloc=xloc.bar_time, color=color.orange, style=line.style_dashed, width=1)
    label.new(x=math.round((PEAK_1 + PEAK_2) / 2), y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=pText, style=label.style_label_down, color=color.orange, textcolor=color.white, size=lblSizeMinor)
    drewP1toP2 := true

if crossesDate(PEAK_3) and not drewP2toP3 and i_showPeakAnalysis and barstate.isconfirmed
    string pText = "peak to peak\n" + str.tostring(p2_to_p3) + "d"
    line.new(x1=PEAK_2, y1=high, x2=PEAK_3, y2=high, xloc=xloc.bar_time, color=color.orange, style=line.style_dashed, width=1)
    label.new(x=math.round((PEAK_2 + PEAK_3) / 2), y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=pText, style=label.style_label_down, color=color.orange, textcolor=color.white, size=lblSizeMinor)
    drewP2toP3 := true

if crossesDate(PEAK_4) and not drewP3toP4 and i_showPeakAnalysis and barstate.isconfirmed
    string pText = "peak to peak\n" + str.tostring(p3_to_p4) + "d"
    line.new(x1=PEAK_3, y1=high, x2=PEAK_4, y2=high, xloc=xloc.bar_time, color=color.orange, style=line.style_dashed, width=1)
    label.new(x=math.round((PEAK_3 + PEAK_4) / 2), y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=pText, style=label.style_label_down, color=color.orange, textcolor=color.white, size=lblSizeMinor)
    drewP3toP4 := true

// PEAK_4 → PEAK_5 connection (draw on last bar if Peak 5 enabled)
var bool drewP4toP5 = false
if i_usePeak5 and barstate.islast and not drewP4toP5 and i_showPeakAnalysis
    int p4_to_p5 = daysFromMs(PEAK_5 - PEAK_4)
    line.new(x1=PEAK_4, y1=high, x2=PEAK_5, y2=high, xloc=xloc.bar_time, color=color.orange, style=line.style_dashed, width=1)
    label.new(x=math.round((PEAK_4 + PEAK_5) / 2), y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text="peak to peak\n" + str.tostring(p4_to_p5) + "d", style=label.style_label_down, color=color.orange, textcolor=color.white, size=lblSizeMinor)
    drewP4toP5 := true

// --- Compression Analysis ---
float avgPeakToPeak = (p1_to_p2 + p2_to_p3 + p3_to_p4) / 3.0

// Compression: how much shorter each successive cycle is vs the prior one (as %)
// Negative value = cycle is compressing (getting shorter)
float compression_2_vs_1 = p1_to_p2 != 0 ? ((p2_to_p3 - p1_to_p2) / float(p1_to_p2)) * 100.0 : 0.0
float compression_3_vs_2 = p2_to_p3 != 0 ? ((p3_to_p4 - p2_to_p3) / float(p2_to_p3)) * 100.0 : 0.0
float cycleCompression = (compression_2_vs_1 + compression_3_vs_2) / 2.0

// --- Peak Projection ---
// Estimate next cycle length by applying average compression to last interval
float compressFactor = 1.0 + (cycleCompression / 100.0)
int   estimatedNextCycle = math.round(p3_to_p4 * compressFactor)
// Clamp: don't let estimated cycle go below 1,000 days or above 1,600 days
int   clampedNextCycle = math.max(1000, math.min(1600, estimatedNextCycle))

// Use PEAK_5 as anchor if enabled (2025 top already confirmed), else PEAK_4
int latestPeak = i_usePeak5 ? PEAK_5 : PEAK_4
int projectedPeakTime       = latestPeak + clampedNextCycle * MS_PER_DAY
int projectedPeakRangeStart = latestPeak + math.round(clampedNextCycle * 0.9) * MS_PER_DAY   // optimistic (earlier)
int projectedPeakRangeEnd   = latestPeak + math.round(clampedNextCycle * 1.1) * MS_PER_DAY   // conservative (later)


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 7b: BOTTOM_4 TO PROJECTED PEAK (deferred from Section 7)
// ═══════════════════════════════════════════════════════════════════════════════

// Draw BOTTOM_4 to projected peak on the last bar
if barstate.islast and not drewB4toProj and i_showBottomMarkers
    int estDur = daysFromMs(projectedPeakTime - BOTTOM_4)
    string durText = "bottom to top\n" + str.tostring(estDur) + "d?"
    line.new(x1=BOTTOM_4, y1=close, x2=projectedPeakTime, y2=close, xloc=xloc.bar_time, color=i_bottomColor, style=line.style_arrow_right, width=1)
    label.new(x=math.round((BOTTOM_4 + projectedPeakTime) / 2), y=close, xloc=xloc.bar_time, text=durText, style=label.style_label_up, color=i_bottomColor, textcolor=color.black, size=lblSizeMinor)
    drewB4toProj := true
// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 9: MATHEMATICAL SEQUENCE CALCULATOR
// Based on @killaxbt's chart analysis - decreasing interval pattern
// ═══════════════════════════════════════════════════════════════════════════════

// DYNAMIC intervals - calculated from actual cycle dates
float ptpInterval1 = daysFromMs(PEAK_2 - PEAK_1)   // Peak 1 → Peak 2
float ptpInterval2 = daysFromMs(PEAK_3 - PEAK_2)   // Peak 2 → Peak 3
float ptpInterval3 = daysFromMs(PEAK_4 - PEAK_3)   // Peak 3 → Peak 4

float h2tInterval1 = daysFromMs(PEAK_2 - HALVING_1)   // Halving 1 → Peak 2
float h2tInterval2 = daysFromMs(PEAK_3 - HALVING_2)   // Halving 2 → Peak 3
float h2tInterval3 = daysFromMs(PEAK_4 - HALVING_3)   // Halving 3 → Peak 4

float b2tInterval1 = daysFromMs(PEAK_2 - BOTTOM_1)   // Bottom 1 → Peak 2
float b2tInterval2 = daysFromMs(PEAK_3 - BOTTOM_2)   // Bottom 2 → Peak 3
float b2tInterval3 = daysFromMs(PEAK_4 - BOTTOM_3)   // Bottom 3 → Peak 4

// ATH break intervals (days) from chart
var float athBreak1 = 1170.0
var float athBreak2 = 983.0
var float athBreak3 = 364.0

// Sequence values noted on chart: 277, 228, 496
var float seqVal1 = 277.0
var float seqVal2 = 228.0
var float seqVal3 = 496.0

// Output variables
float seqNextPeakToPeak       = 0.0
float seqNextBottomToTop      = 0.0
float seqNextHalvingToTop     = 0.0
int   seqProjectedTopFromHalving = 0
int   seqProjectedTopFromBottom  = 0

// ── Method A: Linear Trend (decreasing/stable interval extrapolation) ──

// Peak-to-peak: differences are -56, -2 → compressing toward ~1400d
float ptpDiff1_A = ptpInterval2 - ptpInterval1   // -56
float ptpDiff2_A = ptpInterval3 - ptpInterval2   // -2
// Trend of differences: the deceleration is itself shrinking
// Linear extrapolation of the difference: next diff ≈ ptpDiff2_A + (ptpDiff2_A - ptpDiff1_A)
float ptpDiff3_A = ptpDiff2_A + (ptpDiff2_A - ptpDiff1_A)  // -2 + 54 = 52 (rebound)
// Clamp: intervals unlikely to grow, so cap the next diff at 0
float ptpNextLinear = ptpInterval3 + math.min(ptpDiff3_A, 0.0)

// Bottom-to-top: differences are +322, -7
float b2tDiff1_A = b2tInterval2 - b2tInterval1   // 322
float b2tDiff2_A = b2tInterval3 - b2tInterval2   // -7
float b2tDiff3_A = b2tDiff2_A + (b2tDiff2_A - b2tDiff1_A)  // -7 + (-329) = -336
float b2tNextLinear = b2tInterval3 + b2tDiff3_A

// Halving-to-top: differences are +158, +24
float h2tDiff1_A = h2tInterval2 - h2tInterval1   // 158
float h2tDiff2_A = h2tInterval3 - h2tInterval2   // 24
float h2tDiff3_A = h2tDiff2_A + (h2tDiff2_A - h2tDiff1_A)  // 24 + (-134) = -110
float h2tNextLinear = h2tInterval3 + h2tDiff3_A

// ── Method B: Halve the Difference ──
// From the chart's method:
//   Step 1: Find difference between last two intervals
//   Step 2: Halve it
//   Step 3: Subtract from last interval

// Peak-to-peak halve-the-difference
float ptpLastDiff    = math.abs(ptpInterval3 - ptpInterval2)  // |−2| = 2
float ptpHalved      = ptpLastDiff / 2.0                       // 1
float ptpNextHalve   = ptpInterval3 - ptpHalved                // 1418 - 1 = 1417

// Bottom-to-top halve-the-difference
float b2tLastDiff    = math.abs(b2tInterval3 - b2tInterval2)  // |−7| = 7
float b2tHalved      = b2tLastDiff / 2.0                       // 3.5
float b2tNextHalve   = b2tInterval3 - b2tHalved                // 1057 - 3.5 = 1053.5

// Halving-to-top halve-the-difference
float h2tLastDiff    = math.abs(h2tInterval3 - h2tInterval2)  // |24| = 24
float h2tHalved      = h2tLastDiff / 2.0                       // 12
float h2tNextHalve = h2tInterval3 - (math.abs(h2tInterval3 - h2tInterval2) / 2.0)

// ── Combine: Average of Method A and Method B ──
seqNextPeakToPeak    := (ptpNextLinear + ptpNextHalve) / 2.0
seqNextBottomToTop   := math.max((b2tNextLinear + b2tNextHalve) / 2.0, 300.0)  // floor at 300d
seqNextHalvingToTop  := (h2tNextLinear + h2tNextHalve) / 2.0

// ── Projected top timestamps ──
seqProjectedTopFromHalving := HALVING_4 + math.round(seqNextHalvingToTop) * MS_PER_DAY
seqProjectedTopFromBottom  := BOTTOM_4  + math.round(seqNextBottomToTop)  * MS_PER_DAY


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 10: CYCLE PHASE INDICATOR
// Cycle phases with compression adjustment
// Historical patterns show cycle compression ~2-5% per cycle
// ═══════════════════════════════════════════════════════════════════════════════

string currentPhase  = "Unknown"
color  phaseColor    = color.gray
float  phaseProgress = 0.0
string phaseWarning  = ""

// Phase boundaries (days since halving)
int PHASE_ACCUM_END = 200    // 0-200d:   Accumulation
int PHASE_EARLY_END = 400    // 200-400d: Early Bull
int PHASE_PARA_END  = 550    // 400-550d: Parabolic
int PHASE_DIST_END  = 700    // 550-700d: Distribution
                              // 700d+:    Bear Market

// ── Determine current phase ──
if daysSinceHalving < 0
    currentPhase := "Pre-Halving"
    phaseColor := color.gray
    phaseProgress := 0.0
else if daysSinceHalving <= PHASE_ACCUM_END
    currentPhase := "Accumulation"
    phaseColor   := color.gray
    phaseProgress := (daysSinceHalving / float(PHASE_ACCUM_END)) * 100.0
else if daysSinceHalving <= PHASE_EARLY_END
    currentPhase := "Early Bull"
    phaseColor   := color.green
    phaseProgress := ((daysSinceHalving - PHASE_ACCUM_END) / float(PHASE_EARLY_END - PHASE_ACCUM_END)) * 100.0
else if daysSinceHalving <= PHASE_PARA_END
    currentPhase := "Parabolic"
    phaseColor   := color.aqua
    phaseProgress := ((daysSinceHalving - PHASE_EARLY_END) / float(PHASE_PARA_END - PHASE_EARLY_END)) * 100.0
else if daysSinceHalving <= PHASE_DIST_END
    currentPhase := "Distribution"
    phaseColor   := color.orange
    phaseProgress := ((daysSinceHalving - PHASE_PARA_END) / float(PHASE_DIST_END - PHASE_PARA_END)) * 100.0
else
    currentPhase := "Bear Market"
    phaseColor   := color.red
    // In bear market, measure from distribution end; cap at 100%
    phaseProgress := math.min(((daysSinceHalving - PHASE_DIST_END) / 300.0) * 100.0, 100.0)

// ── Late-cycle warnings ──
phaseWarning := ""
if daysSinceHalving > 600
    phaseWarning := "🔴 Very late cycle"
else if daysSinceHalving > 500
    phaseWarning := "⚠ Late cycle - 100-120 days may remain"

// ── Visual output ──
bgcolor(i_showPhases and i_phaseStyle == "Background" ? color.new(phaseColor, 90) : na)
barcolor(i_showPhases and i_phaseStyle == "Bars" ? phaseColor : na)


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 11: LOGARITHMIC GROWTH CURVES
// Simplified log growth model for Bitcoin cycle analysis
// ═══════════════════════════════════════════════════════════════════════════════

// Bitcoin's long-term log growth rate approximately halves each cycle
// Cycle 1: ~0.5% daily, Cycle 2: ~0.25%, Cycle 3: ~0.12%, Cycle 4: ~0.3% (~0.003 reasonable default)
// Log growth rate now comes from input i_logGrowthRate (defined in section_1)

// Curve values (na when disabled so plots draw nothing)
float fairValue  = na
float upperBand2 = na
float upperBand1 = na
float lowerBand1 = na
float lowerBand2 = na

if i_showLogCurves and lastBottomTime > 0 and daysSinceBottom > 0
    // Expected log-linear price at current day since cycle bottom
    float expectedLogPrice = math.log(cycleBasePrice) + i_logGrowthRate * daysSinceBottom
    fairValue  := math.exp(expectedLogPrice)

    // Bands at multipliers of fair value
    upperBand2 := fairValue * 5.0    // Extreme overbought
    upperBand1 := fairValue * 2.5    // Overbought
    lowerBand1 := fairValue * 0.5    // Oversold
    lowerBand2 := fairValue * 0.25   // Extreme oversold

// ── Plot logarithmic growth curves ──
fvPlot  = plot(i_showLogCurves ? fairValue  : na, "Fair Value",         color.new(color.white,  50), linewidth=2)
ub2Plot = plot(i_showLogCurves ? upperBand2 : na, "Extreme Overbought", color.new(color.red,    60), linewidth=1)
ub1Plot = plot(i_showLogCurves ? upperBand1 : na, "Overbought",         color.new(color.orange, 60), linewidth=1)
lb1Plot = plot(i_showLogCurves ? lowerBand1 : na, "Oversold",           color.new(color.green,  60), linewidth=1)
lb2Plot = plot(i_showLogCurves ? lowerBand2 : na, "Extreme Oversold",   color.new(color.teal,   60), linewidth=1)

// ── Rainbow fill between bands ──
fill(ub2Plot, ub1Plot, color.new(color.red,    92), title="Extreme Overbought Zone")
fill(ub1Plot, fvPlot,  color.new(color.orange, 92), title="Premium Zone")
fill(fvPlot,  lb1Plot, color.new(color.green,  92), title="Discount Zone")
fill(lb1Plot, lb2Plot, color.new(color.teal,   92), title="Oversold Zone")

// ═══════════════ INFO DASHBOARD TABLE ═══════════════

// --- Table position mapping ---
dashPos = switch i_dashPosition
    "Top Right"     => position.top_right
    "Top Left"      => position.top_left
    "Bottom Right"  => position.bottom_right
    "Bottom Left"   => position.bottom_left
    => position.top_right

var color DASH_BG      = #1a1a2e
var color DASH_BORDER  = #16213e
var color LABEL_COLOR  = #8892b0

var table dashTable = table.new(dashPos, 2, 14, bgcolor = DASH_BG, border_color = DASH_BORDER, border_width = 1, frame_color = DASH_BORDER, frame_width = 2)

if barstate.islast and i_showDashboard
    // Row 0 — Header (two cells instead of merged)
    table.cell(dashTable, 0, 0, "BTC CYCLE MASTER", text_color = color.yellow, text_size = size.normal, text_halign = text.align_center, bgcolor = DASH_BG)
    table.cell(dashTable, 1, 0, "@killaxbt", text_color = color.yellow, text_size = size.small, text_halign = text.align_center, bgcolor = DASH_BG)

    // Row 1 — Days Since Halving
    table.cell(dashTable, 0, 1, "Days Since Halving", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    string dshText = daysSinceHalving >= 0 ? str.tostring(daysSinceHalving) + "d" : "Pre-Halving"
    table.cell(dashTable, 1, 1, dshText, text_color = color.white, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 2 — Days Since Bottom
    table.cell(dashTable, 0, 2, "Days Since Bottom", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    dsbText = daysSinceBottom > 0 ? str.tostring(daysSinceBottom) + "d" : "N/A"
    table.cell(dashTable, 1, 2, dsbText, text_color = color.white, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 3 — Days Since Last ATH
    table.cell(dashTable, 0, 3, "Days Since Last ATH", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    athColor = daysSinceATH < 30 ? color.green : daysSinceATH < 100 ? color.yellow : color.red
    table.cell(dashTable, 1, 3, str.tostring(daysSinceATH) + "d", text_color = athColor, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 4 — Current Phase
    table.cell(dashTable, 0, 4, "Current Phase", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    table.cell(dashTable, 1, 4, currentPhase, text_color = phaseColor, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 5 — Phase Progress
    table.cell(dashTable, 0, 5, "Phase Progress", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    table.cell(dashTable, 1, 5, str.tostring(phaseProgress, "0.0") + "%", text_color = phaseColor, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 6 — Current ATH
    table.cell(dashTable, 0, 6, "Current ATH", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    table.cell(dashTable, 1, 6, "$" + str.tostring(math.round(ath)), text_color = color.lime, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 7 — ATH Break Days (historical)
    table.cell(dashTable, 0, 7, "ATH Break Days (hist)", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    athBreakStr = ""
    athArrSize  = array.size(athBreakDaysArray)
    if athArrSize > 0
        startIdx = math.max(0, athArrSize - 3)
        for idx = startIdx to athArrSize - 1
            if idx > startIdx
                athBreakStr := athBreakStr + ", "
            athBreakStr := athBreakStr + str.tostring(array.get(athBreakDaysArray, idx)) + "d"
    else
        athBreakStr := "--"
    table.cell(dashTable, 1, 7, athBreakStr, text_color = color.white, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 8 — Avg Peak-to-Peak
    table.cell(dashTable, 0, 8, "Avg Peak-to-Peak", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    p2pText = avgPeakToPeak > 0 ? str.tostring(avgPeakToPeak, "0.0") + "d" : "N/A"
    table.cell(dashTable, 1, 8, p2pText, text_color = color.white, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 9 — Cycle Compression
    table.cell(dashTable, 0, 9, "Cycle Compression", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    compColor = cycleCompression < 0 ? color.orange : color.white
    table.cell(dashTable, 1, 9, str.tostring(cycleCompression, "0.00") + "%", text_color = compColor, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 10 — Seq: Next P2P
    table.cell(dashTable, 0, 10, "Seq: Next P2P", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    seqP2PText = seqNextPeakToPeak > 0 ? str.tostring(seqNextPeakToPeak, "0.0") + "d" : "N/A"
    table.cell(dashTable, 1, 10, seqP2PText, text_color = color.aqua, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 11 — Seq: Next B2T
    table.cell(dashTable, 0, 11, "Seq: Next B2T", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    seqB2TText = seqNextBottomToTop > 0 ? str.tostring(seqNextBottomToTop, "0.0") + "d" : "N/A"
    table.cell(dashTable, 1, 11, seqB2TText, text_color = color.aqua, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 12 — Projected Top
    table.cell(dashTable, 0, 12, "Projected Top", text_color = LABEL_COLOR, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    projTopText = projectedPeakRangeStart > 0 and projectedPeakRangeEnd > 0 ? formatDate(projectedPeakRangeStart) + " to " + formatDate(projectedPeakRangeEnd) : "N/A"
    table.cell(dashTable, 1, 12, projTopText, text_color = color.orange, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)

    // Row 13 — Warning (pre-calculated conditional values)
    string warnLabel = str.length(phaseWarning) > 0 ? "Warning" : ""
    string warnText  = str.length(phaseWarning) > 0 ? phaseWarning : ""
    color  warnColor = str.length(phaseWarning) > 0 ? color.red : LABEL_COLOR
    table.cell(dashTable, 0, 13, warnLabel, text_color = warnColor, text_size = size.small, text_halign = text.align_left, bgcolor = DASH_BG)
    table.cell(dashTable, 1, 13, warnText, text_color = color.red, text_size = size.small, text_halign = text.align_right, bgcolor = DASH_BG)


// ═══════════════ PROJECTED ZONES ═══════════════

var box projTopBox      = na
var box athBreakBox     = na
var box lateCycleBox    = na
var box projBottomBox   = na
var label projTopLbl    = na
var label athBreakLbl   = na
var label lateCycleLbl  = na
var label projBottomLbl = na

if barstate.islast and i_showProjections
    // --- Clean up previous drawings ---
    if not na(projTopBox)
        box.delete(projTopBox)
    if not na(athBreakBox)
        box.delete(athBreakBox)
    if not na(lateCycleBox)
        box.delete(lateCycleBox)
    if not na(projBottomBox)
        box.delete(projBottomBox)
    if not na(projTopLbl)
        label.delete(projTopLbl)
    if not na(athBreakLbl)
        label.delete(athBreakLbl)
    if not na(lateCycleLbl)
        label.delete(lateCycleLbl)
    if not na(projBottomLbl)
        label.delete(projBottomLbl)

    // --- 1. Projected Top Time Zone ---
    if projectedPeakRangeStart > 0 and projectedPeakRangeEnd > 0
        boxTop    = high * 1.5
        boxBottom = low * 0.5
        projTopBox := box.new(
             left     = projectedPeakRangeStart,
             top      = boxTop,
             right    = projectedPeakRangeEnd,
             bottom   = boxBottom,
             xloc     = xloc.bar_time,
             bgcolor  = color.new(i_projTopColor, 85),
             border_color = i_projTopColor,
             border_width = 1)
        projTopLbl := label.new(
             x        = math.round((projectedPeakRangeStart + projectedPeakRangeEnd) / 2),
             y        = boxTop,
             text     = "Projected Top Zone",
             xloc     = xloc.bar_time,
             yloc     = yloc.price,
             style    = label.style_label_down,
             color    = color.new(i_projTopColor, 70),
             textcolor = color.white,
             size     = lblSizeZone)

    // --- 2. ATH Break Zone After Halving ---
    int athBreakStart = HALVING_4 + 170 * MS_PER_DAY
    int athBreakEnd   = HALVING_4 + 400 * MS_PER_DAY
    if time < athBreakEnd  // Only show if window not yet fully passed
        athBreakBox := box.new(
             left     = athBreakStart,
             top      = high * 1.5,
             right    = athBreakEnd,
             bottom   = low * 0.5,
             xloc     = xloc.bar_time,
             bgcolor  = color.new(color.aqua, 90),
             border_color = color.new(color.aqua, 60),
             border_width = 1)
        athBreakLbl := label.new(
             x        = math.round((athBreakStart + athBreakEnd) / 2),
             y        = high * 1.3,
             text     = "ATH Break Window\n170-400d post-halving",
             xloc     = xloc.bar_time,
             yloc     = yloc.price,
             style    = label.style_label_down,
             color    = color.new(color.aqua, 80),
             textcolor = color.aqua,
             size     = lblSizeZone)

    // --- 3. End of Cycle Warning Zone ---
    if daysSinceHalving > 500
        lateCycleStart = time
        lateCycleEnd   = projectedPeakRangeEnd > 0 ? projectedPeakRangeEnd : time + 120 * MS_PER_DAY
        lateCycleBox := box.new(
             left     = lateCycleStart,
             top      = high * 1.2,
             right    = lateCycleEnd,
             bottom   = low * 0.8,
             xloc     = xloc.bar_time,
             bgcolor  = color.new(color.red, 92),
             border_color = color.new(color.red, 70),
             border_width = 1)
        lateCycleLbl := label.new(
             x        = math.round((lateCycleStart + lateCycleEnd) / 2),
             y        = high * 1.15,
             text     = "Late Cycle Warning\n100-120d may remain",
             xloc     = xloc.bar_time,
             yloc     = yloc.price,
             style    = label.style_label_down,
             color    = color.new(color.red, 80),
             textcolor = color.red,
             size     = lblSizeZone)

    // --- 4. Projected Bottom Zone (bear market bottom after projected top) ---
    if projectedPeakTime > 0
        projBottomStart = projectedPeakTime + 300 * MS_PER_DAY
        projBottomEnd   = projectedPeakTime + 420 * MS_PER_DAY
        projBottomBox := box.new(
             left     = projBottomStart,
             top      = high * 1.0,
             right    = projBottomEnd,
             bottom   = low * 0.3,
             xloc     = xloc.bar_time,
             bgcolor  = color.new(i_projBottomColor, 85),
             border_color = i_projBottomColor,
             border_width = 1)
        projBottomLbl := label.new(
             x        = math.round((projBottomStart + projBottomEnd) / 2),
             y        = high * 0.9,
             text     = "Projected Bottom Zone",
             xloc     = xloc.bar_time,
             yloc     = yloc.price,
             style    = label.style_label_down,
             color    = color.new(i_projBottomColor, 70),
             textcolor = color.white,
             size     = lblSizeZone)


// ═══════════════ TICKER WARNING ═══════════════
var bool isBTC = str.contains(str.upper(syminfo.ticker), "BTC") or str.contains(str.upper(syminfo.ticker), "XBT")
var label btcWarningLbl = na
if barstate.islast and not isBTC and na(btcWarningLbl)
    btcWarningLbl := label.new(bar_index, close, "This indicator is designed for BTC charts only",
              style = label.style_label_down, color = color.red, textcolor = color.white, size = size.large)


