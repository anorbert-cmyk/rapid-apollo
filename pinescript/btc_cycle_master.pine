// SECTION 17: HELP / USAGE PANEL
// ═══════════════════════════════════════════════════════════════════════════════

var table helpTable = table.new(position.middle_center, 1, 1, bgcolor=color.new(#1a1a2e, 10), border_color=color.yellow, border_width=2, frame_color=color.yellow, frame_width=2)

if barstate.islast and i_showHelp
    string helpText = "═══ BTC CYCLE MASTER - HOW TO USE ═══\n"
    helpText += "\n"
    helpText += "📋 SETUP:\n"
    helpText += "• Use on BTCUSD Daily chart (Bitstamp/Coinbase recommended)\n"
    helpText += "• Switch to logarithmic price scale for best results\n"
    helpText += "\n"
    helpText += "⚙️  KEY SETTINGS:\n"
    helpText += "• Display Settings: Toggle each feature on/off\n"
    helpText += "• Colors: Customize all visual elements\n"
    helpText += "• Label Sizes: Adjust for your screen (tiny→huge)\n"
    helpText += "• Cycle Dates: Override historical peak/bottom dates\n"
    helpText += "• Log Growth Rate: Fair-value curve steepness (default 0.003)\n"
    helpText += "\n"
    helpText += "🎯 2025 CYCLE:\n"
    helpText += "• Enable 'Use Peak 5 (2025 Top)' when top confirmed\n"
    helpText += "• Adjust Peak 5 date to actual top\n"
    helpText += "• Projections will re-anchor to Peak 5\n"
    helpText += "\n"
    helpText += "📊 DASHBOARD COLUMNS:\n"
    helpText += "• Days Since Halving → current cycle position\n"
    helpText += "• Current Phase → Accumulation/Bull/Parabolic/Distribution/Bear\n"
    helpText += "• ATH Break Days → historical: 1170d→983d→364d (compressing)\n"
    helpText += "• Avg Peak-to-Peak → average cycle length from your data\n"
    helpText += "• Seq: Next P2P/B2T → projected next cycle via 2 methods\n"
    helpText += "• Projected Top → date range for next cycle top\n"
    helpText += "\n"
    helpText += "🎨 VISUAL ELEMENTS:\n"
    helpText += "• Yellow dashed lines → Halving dates\n"
    helpText += "• Red dashed lines → US Election dates\n"
    helpText += "• Orange lines → Peak-to-peak intervals\n"
    helpText += "• Cyan arrows → Bottom-to-top duration\n"
    helpText += "• Green triangles → Recent new ATHs\n"
    helpText += "• Rainbow bands → Log growth valuation zones\n"
    helpText += "• Orange/Teal boxes → Projected top/bottom zones\n"
    helpText += "\n"
    helpText += "🔬 THEORY (killaxbt):\n"
    helpText += "• Each cycle compresses vs. previous (~2-5% shorter)\n"
    helpText += "• 'Top sooner, bottom sooner' pattern\n"
    helpText += "• ATH Break window: 170-400d post-halving\n"
    helpText += "• Late cycle warning after 500d from halving\n"
    helpText += "\n"
    helpText += "❓ Toggle this panel off when done reading.\n"
    table.cell(helpTable, 0, 0, helpText, text_color=color.white, text_size=size.normal, text_halign=text.align_left, bgcolor=color.new(#1a1a2e, 10))
