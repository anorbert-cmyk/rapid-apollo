// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 0: HEADER
// ═══════════════════════════════════════════════════════════════════════════════

//@version=5
indicator("BTC Cycle Master - @killaxbt Analysis", overlay=true, max_lines_count=500, max_labels_count=500, max_boxes_count=500)


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 1: INPUT PARAMETERS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Display Settings ---
i_showHalvings      = input.bool(true, "Show Halving Lines",          group="📊 Display Settings")
i_showElections     = input.bool(true, "Show Election Day Lines",     group="📊 Display Settings")
i_showATH           = input.bool(true, "Show ATH Markers",           group="📊 Display Settings")
i_showATHBreakDays  = input.bool(true, "Show ATH Break Days Labels", group="📊 Display Settings")
i_showBottomMarkers = input.bool(true, "Show Cycle Bottom Markers",  group="📊 Display Settings")
i_showPeakAnalysis  = input.bool(true, "Show Peak-to-Peak Analysis", group="📊 Display Settings")
i_showPhases        = input.bool(true, "Show Cycle Phases",          group="📊 Display Settings")
i_showLogCurves     = input.bool(true, "Show Log Growth Curves",     group="📊 Display Settings")
i_showDashboard     = input.bool(true, "Show Info Dashboard",        group="📊 Display Settings")
i_showProjections   = input.bool(true, "Show Projected Zones",       group="📊 Display Settings")

// --- Colors ---
i_halvingColor    = input.color(color.yellow, "Halving Color",           group="🎨 Colors")
i_electionColor   = input.color(color.red,    "Election Color",          group="🎨 Colors")
i_athColor        = input.color(color.lime,   "ATH Color",              group="🎨 Colors")
i_bottomColor     = input.color(color.aqua,   "Bottom Color",           group="🎨 Colors")
i_bullColor       = input.color(color.green,  "Bull Color",             group="🎨 Colors")
i_bearColor       = input.color(color.red,    "Bear Color",             group="🎨 Colors")
i_projTopColor    = input.color(color.orange, "Projection Top Color",   group="🎨 Colors")
i_projBottomColor = input.color(color.teal,   "Projection Bottom Color", group="🎨 Colors")

// --- Analysis Settings ---
i_phaseStyle    = input.string("Background", "Phase Display Style", options=["Background", "Bars", "None"], group="🔧 Analysis Settings")
i_dashPosition  = input.string("Top Right",  "Dashboard Position",  options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group="🔧 Analysis Settings")
i_logGrowthRate = input.float(0.003, "Log Growth Rate (daily)", minval=0.0001, maxval=0.01, step=0.0001, group="🔧 Analysis Settings")

// --- Auto-Detection Settings ---
i_autoDetect    = input.bool(false, "Enable Auto Peak/Bottom Detection", group="Auto-Detection Settings")
i_pivotLeft     = input.int(150, "Pivot Left Bars (confirmation)",  minval=30, maxval=300, group="Auto-Detection Settings")
i_pivotRight    = input.int(150, "Pivot Right Bars (confirmation)", minval=30, maxval=300, group="Auto-Detection Settings")
i_minCycleDays  = input.int(365, "Min Days Between Cycle Events",   minval=180, maxval=1000, group="Auto-Detection Settings")


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 2: CONSTANTS
// ═══════════════════════════════════════════════════════════════════════════════

// --- Halving Dates (UTC) ---
HALVING_1 = timestamp("UTC", 2012, 11, 28, 0, 0)
HALVING_2 = timestamp("UTC", 2016,  7,  9, 0, 0)
HALVING_3 = timestamp("UTC", 2020,  5, 11, 0, 0)
HALVING_4 = timestamp("UTC", 2024,  4, 20, 0, 0)
HALVING_5 = timestamp("UTC", 2028,  3, 15, 0, 0)  // Estimated

// --- Election Dates (UTC) ---
ELECTION_2012 = timestamp("UTC", 2012, 11,  6, 0, 0)
ELECTION_2016 = timestamp("UTC", 2016, 11,  8, 0, 0)
ELECTION_2020 = timestamp("UTC", 2020, 11,  3, 0, 0)
ELECTION_2024 = timestamp("UTC", 2024, 11,  5, 0, 0)
ELECTION_2028 = timestamp("UTC", 2028, 11,  7, 0, 0)

// --- Cycle Bottom Dates (User Override) ---
BOTTOM_1 = input.time(timestamp("UTC", 2011, 11, 18, 0, 0), "Bottom 1", group="Cycle Dates (Manual Override)", confirm=false)
BOTTOM_2 = input.time(timestamp("UTC", 2015,  1, 14, 0, 0), "Bottom 2", group="Cycle Dates (Manual Override)", confirm=false)
BOTTOM_3 = input.time(timestamp("UTC", 2018, 12, 15, 0, 0), "Bottom 3", group="Cycle Dates (Manual Override)", confirm=false)
BOTTOM_4 = input.time(timestamp("UTC", 2022, 11, 21, 0, 0), "Bottom 4", group="Cycle Dates (Manual Override)", confirm=false)

// --- Cycle Peak Dates (User Override) ---
PEAK_1 = input.time(timestamp("UTC", 2011,  6,  8, 0, 0), "Peak 1", group="Cycle Dates (Manual Override)", confirm=false)
PEAK_2 = input.time(timestamp("UTC", 2013, 11, 30, 0, 0), "Peak 2", group="Cycle Dates (Manual Override)", confirm=false)
PEAK_3 = input.time(timestamp("UTC", 2017, 12, 17, 0, 0), "Peak 3", group="Cycle Dates (Manual Override)", confirm=false)
PEAK_4 = input.time(timestamp("UTC", 2021, 11, 10, 0, 0), "Peak 4", group="Cycle Dates (Manual Override)", confirm=false)

// --- Helper Constant ---
MS_PER_DAY = 86400000

// --- Halving Arrays ---
var array<int>    halvingDates = array.from(HALVING_1, HALVING_2, HALVING_3, HALVING_4, HALVING_5)
var array<string> halvingNames = array.from("Halving #1", "Halving #2", "Halving #3", "Halving #4", "Halving #5")

// --- Election Arrays ---
var array<int>    electionDates = array.from(ELECTION_2012, ELECTION_2016, ELECTION_2020, ELECTION_2024, ELECTION_2028)
var array<string> electionNames = array.from("Election 2012", "Election 2016", "Election 2020", "Election 2024", "Election 2028")

// NOTE: bottomDates and peakDates arrays are defined dynamically in section_2.pine
//       based on manual overrides and/or auto-detection results.


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 3: UTILITY FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

// Convert timestamp difference to days
daysFromMs(int ms) =>
    int(math.floor(ms / float(MS_PER_DAY)))

// Check if current bar crosses a timestamp
crossesDate(int targetTime) =>
    (na(time[1]) or time[1] < targetTime) and time >= targetTime

// Format days as string with "d" suffix
formatDays(int d) =>
    str.tostring(d) + "d"

// Zero-pad integer to two digits
padZero(int n) => n < 10 ? "0" + str.tostring(n) : str.tostring(n)

// Format a timestamp as YYYY-MM-DD
formatDate(int t) => str.tostring(year(t)) + "-" + padZero(month(t)) + "-" + padZero(dayofmonth(t))


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 4: FEATURE 1 - HALVING MARKERS
// ═══════════════════════════════════════════════════════════════════════════════

var int lastHalvingTime = na

if i_showHalvings
    for i = 0 to array.size(halvingDates) - 1
        int hDate = array.get(halvingDates, i)
        if crossesDate(hDate) and barstate.isconfirmed
            // Draw vertical dashed line at halving date
            line.new(x1=hDate, y1=low, x2=hDate, y2=high, xloc=xloc.bar_time, extend=extend.both, color=i_halvingColor, style=line.style_dashed, width=1)
            // Format the date string for label
            string dateStr = formatDate(hDate)
            string lblText = array.get(halvingNames, i) + "\n" + dateStr
            label.new(x=hDate, y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=lblText, style=label.style_label_down, color=i_halvingColor, textcolor=color.black, size=size.small)

// Track the most recent halving that has passed
if array.size(halvingDates) > 0
    for i = 0 to array.size(halvingDates) - 1
        int hDate = array.get(halvingDates, i)
        if time >= hDate
            lastHalvingTime := hDate

// Calculate days since last halving
int daysSinceHalving = not na(lastHalvingTime) ? daysFromMs(time - lastHalvingTime) : 0


// ═══════════════════════════════════════════════════════════════════════════════
// SECTION 5: FEATURE 2 - ELECTION DAY MARKERS
// ═══════════════════════════════════════════════════════════════════════════════

if i_showElections
    for i = 0 to array.size(electionDates) - 1
        int eDate = array.get(electionDates, i)
        if crossesDate(eDate) and barstate.isconfirmed
            // Draw vertical dashed line at election date
            line.new(x1=eDate, y1=low, x2=eDate, y2=high, xloc=xloc.bar_time, extend=extend.both, color=i_electionColor, style=line.style_dashed, width=1)
            // Format the date string for label
            string dateStr = formatDate(eDate)
            string lblText = "🗳 Election\n" + dateStr
            label.new(x=eDate, y=high, xloc=xloc.bar_time, yloc=yloc.abovebar, text=lblText, style=label.style_label_down, color=i_electionColor, textcolor=color.white, size=size.small)
